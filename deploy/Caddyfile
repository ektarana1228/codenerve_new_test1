apexcoder.io {
	root * /srv/candidate

	redir /login* https://candidate.apexcoder.io{uri}
	redir /start* https://candidate.apexcoder.io{uri}
	redir /system-check* https://candidate.apexcoder.io{uri}
	redir /language* https://candidate.apexcoder.io{uri}
	redir /assess* https://candidate.apexcoder.io{uri}
	redir /complete* https://candidate.apexcoder.io{uri}
	redir /mobile-proctor* https://candidate.apexcoder.io{uri}

	handle {
		try_files {path} /index.html
		file_server
	}
}

candidate.apexcoder.io {
	root * /srv/candidate

	handle /api/v1/llm* {
		reverse_proxy api-llm-gateway:3102
	}
	handle /api/v1/vscode* {
		reverse_proxy vscode-orchestrator:3104
	}
	handle /vscode* {
		reverse_proxy vscode-orchestrator:3104
	}
	handle /api* {
		reverse_proxy api-core:3101
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}

