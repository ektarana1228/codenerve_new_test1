# Host-side DB URL for the Prisma CLI (generate/migrate/seed) run from the host.
# Compose services reach Postgres at @postgres:5432; the host reaches the exposed
# port at localhost:5432. Dev credentials match docker-compose.yml.
# `npm run backend` copies this to .env automatically if .env is missing.
DATABASE_URL=postgresql://postgres:password@localhost:5432/platform
