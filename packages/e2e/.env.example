# E2E test environment — copy to .env and fill in values.
# All backend services must be running (docker compose up) before running tests.

# Direct DB connection for global-setup/teardown seeding (bypasses APIs)
DATABASE_URL=postgresql://postgres:password@localhost:5432/platform

# Base URLs for the two frontends (must match Vite dev server ports)
CANDIDATE_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
