DATABASE_URL=postgresql://postgres:password@localhost:5432/platform
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
NODE_ENV=development
PORT=3104

# openvscode-server image for CODING per-session containers (and the default).
VSCODE_IMAGE=gitpod/openvscode-server:1.102.3

# PROJECT (OpenCode) sessions use a purpose-built image with the OpenCode runtime
# + sidebar extension. Build it:
#   docker build -f apps/vscode-orchestrator/project.Dockerfile -t aisd/openvscode-opencode:latest .
VSCODE_PROJECT_IMAGE=aisd/openvscode-opencode:latest

# 'docker' = real openvscode-server containers (needs Docker + the image).
# 'stub'   = dev-only in-process editor page, no Docker required.
VSCODE_MODE=docker

# Compose deployment: set to the shared internal network so the orchestrator
# reaches session containers by name. Leave empty for host dev (random localhost port).
VSCODE_NETWORK=

# PROJECT (OpenCode) containers join this egress-capable network so OpenCode can
# reach the model provider. Leave empty to fall back to VSCODE_NETWORK.
VSCODE_PROJECT_NETWORK=

VSCODE_REAP_INTERVAL_MS=30000
VSCODE_MEMORY_MB=512
VSCODE_CPU_QUOTA=100000
