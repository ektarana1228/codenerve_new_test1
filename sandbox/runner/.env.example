DOCKER_SOCKET=/var/run/docker.sock
SANDBOX_TIMEOUT_MS=10000
SANDBOX_MEMORY_MB=128
SANDBOX_CPU_QUOTA=50000
NODE_ENV=development

# Set SANDBOX_MODE=local to run code directly without Docker (dev only — no isolation).
# Requires python/python3, node, and tsx to be installed on the host.
# SANDBOX_MODE=local

# Override the Python binary used in local mode (default: python3 on Linux/Mac, python on Windows).
# SANDBOX_PYTHON_BIN=python3
